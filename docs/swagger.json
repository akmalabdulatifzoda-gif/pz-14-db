{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Учебный REST API для заметок. ПЗ №14 — PostgreSQL, connection pool, оптимизация запросов.\nМетоды POST, PATCH и DELETE требуют Bearer-токен, если сервер запущен с API_TOKEN.",
        "title": "Notes API",
        "contact": {
            "name": "Абдулатифзода Акмал, ЭФМО-0126",
            "url": "https://github.com/akmalabdulatifzoda-gif/pz-14-db"
        },
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        },
        "version": "1.2"
    },
    "basePath": "/api/v1",
    "paths": {
        "/notes": {
            "get": {
                "description": "По умолчанию — keyset-пагинация: курсор следующей страницы приходит в заголовке X-Next-Cursor.\nПараметр offset включает старую OFFSET-пагинацию (оставлена для сравнения, медленная на больших смещениях).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "notes"
                ],
                "summary": "Список заметок (keyset или offset)",
                "operationId": "listNotes",
                "parameters": [
                    {
                        "maximum": 100,
                        "minimum": 1,
                        "type": "integer",
                        "default": 20,
                        "description": "Размер страницы (1–100)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Курсор из X-Next-Cursor предыдущей страницы",
                        "name": "cursor",
                        "in": "query"
                    },
                    {
                        "minimum": 0,
                        "type": "integer",
                        "description": "Смещение (устаревший режим)",
                        "name": "offset",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/core.Note"
                            }
                        },
                        "headers": {
                            "X-Next-Cursor": {
                                "type": "string",
                                "description": "Курсор следующей страницы (нет — страница последняя)"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/core.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/core.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "notes"
                ],
                "summary": "Создать заметку",
                "operationId": "createNote",
                "parameters": [
                    {
                        "description": "Данные новой заметки",
                        "name": "input",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/core.NoteCreate"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/core.Note"
                        },
                        "headers": {
                            "Location": {
                                "type": "string",
                                "description": "URL созданной заметки"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/core.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/core.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/notes/batch": {
            "get": {
                "description": "Один запрос WHERE id = ANY($1). mode=n1 — старый вариант с отдельным запросом на каждый id (для сравнения).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "notes"
                ],
                "summary": "Получить несколько заметок по id",
                "operationId": "batchNotes",
                "parameters": [
                    {
                        "type": "string",
                        "example": "1,2,3",
                        "description": "Список id через запятую (до 100)",
                        "name": "ids",
                        "in": "query",
                        "required": true
                    },
                    {
                        "enum": [
                            "batch",
                            "n1"
                        ],
                        "type": "string",
                        "description": "batch (по умолчанию) или n1",
                        "name": "mode",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/core.NoteShort"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/core.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/core.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/notes/search": {
            "get": {
                "description": "to_tsvector('simple', title) @@ plainto_tsquery('simple', q) через GIN-индекс idx_notes_title_gin (CTE MATERIALIZED: сначала поиск по индексу, потом сортировка)",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "notes"
                ],
                "summary": "Полнотекстовый поиск по заголовку",
                "operationId": "searchNotes",
                "parameters": [
                    {
                        "type": "string",
                        "example": "redis",
                        "description": "Слова для поиска",
                        "name": "q",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "default": 20,
                        "description": "Сколько результатов (1–100)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "optimized",
                            "naive"
                        ],
                        "type": "string",
                        "description": "optimized (по умолчанию) или naive — исходный запрос для сравнения",
                        "name": "mode",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/core.NoteShort"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/core.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/core.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/notes/{id}": {
            "get": {
                "description": "Чтение через кэш Redis (cache-aside, TTL 60 с), если сервер запущен с REDIS_ADDR",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "notes"
                ],
                "summary": "Получить заметку",
                "operationId": "getNote",
                "parameters": [
                    {
                        "minimum": 1,
                        "type": "integer",
                        "description": "ID заметки",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/core.Note"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/core.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/core.ErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Кэш заметки инвалидируется",
                "tags": [
                    "notes"
                ],
                "summary": "Удалить заметку",
                "operationId": "deleteNote",
                "parameters": [
                    {
                        "minimum": 1,
                        "type": "integer",
                        "description": "ID заметки",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/core.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/core.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/core.ErrorResponse"
                        }
                    }
                }
            },
            "patch": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Транзакция READ COMMITTED: SELECT ... FOR UPDATE + UPDATE; кэш заметки инвалидируется",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "notes"
                ],
                "summary": "Обновить заметку (частично)",
                "operationId": "patchNote",
                "parameters": [
                    {
                        "minimum": 1,
                        "type": "integer",
                        "description": "ID заметки",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Поля для обновления",
                        "name": "input",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/core.NoteUpdate"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/core.Note"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/core.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/core.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/core.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "core.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "описание ошибки"
                }
            }
        },
        "core.Note": {
            "type": "object",
            "properties": {
                "content": {
                    "type": "string",
                    "example": "Добавить пример структуры API"
                },
                "createdAt": {
                    "type": "string",
                    "example": "2026-11-05T12:00:00Z"
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "title": {
                    "type": "string",
                    "example": "Идея для лекции"
                },
                "updatedAt": {
                    "type": "string",
                    "example": "2026-11-05T12:30:00Z"
                }
            }
        },
        "core.NoteCreate": {
            "type": "object",
            "properties": {
                "content": {
                    "type": "string",
                    "example": "Текст заметки"
                },
                "title": {
                    "type": "string",
                    "maxLength": 200,
                    "minLength": 1,
                    "example": "Новая заметка"
                }
            }
        },
        "core.NoteShort": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "title": {
                    "type": "string",
                    "example": "Redis cache #42"
                }
            }
        },
        "core.NoteUpdate": {
            "type": "object",
            "properties": {
                "content": {
                    "type": "string",
                    "example": "Новый текст"
                },
                "title": {
                    "type": "string",
                    "maxLength": 200,
                    "example": "Обновлено"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Введите токен в формате: Bearer ВАШ_ТОКЕН (для демо: Bearer secret)",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}